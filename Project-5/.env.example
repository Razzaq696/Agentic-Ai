# ================================================================
# Intelligent Communication Assistant - Environment Configuration
# ================================================================

# --- SendGrid Configuration ---
# API Key from your SendGrid Account
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Verified sender email in SendGrid
SENDGRID_FROM_EMAIL=notifications@yourdomain.com

# --- Pushover Configuration ---
# Application API Token from Pushover Dashboard
PUSHOVER_API_TOKEN=your_pushover_api_token_here
# User Key from Pushover Dashboard
PUSHOVER_USER_KEY=your_pushover_user_key_here

# --- LLM Provider Configuration (Optional - falls back to deterministic decision engine if not provided) ---
# Gemini API Key (if using Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# --- Mock / Safe Testing Mode ---
# If true or if credentials are empty, tools will operate in safe mock mode without sending real messages
DEFAULT_MOCK_MODE=true
