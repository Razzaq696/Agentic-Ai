# ==============================================================================
# Intelligent Task Execution Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as necessary for your local setup.
# Do NOT commit .env containing sensitive information to version control.

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3:4b
TEMPERATURE=0.0
REQUEST_TIMEOUT=60

# Application Configuration
APP_NAME=Intelligent Task Execution Agent
APP_ENV=development
LOG_LEVEL=INFO

# Streamlit Configuration (Optional overrides)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Optional External API Keys (Defaults run keylessly via local Ollama & DuckDuckGo)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TAVILY_API_KEY=
