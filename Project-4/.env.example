# ==============================================================================
# Automated Document Processing Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as necessary for your local setup.
# Do NOT commit .env containing sensitive information to version control.

# Ollama LLM Configuration (Local Private Inference)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0

# Vector Store & Retrieval Configuration
CHROMA_PERSIST_DIR=./chroma_db
RETRIEVER_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Pipeline Execution Settings
MAX_RETRIES=2

# Optional External API Keys (Defaults run 100% locally and keylessly via Ollama & Chroma)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=