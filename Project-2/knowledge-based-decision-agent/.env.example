# ==============================================================================
# Knowledge-Based Decision Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as necessary for your local setup.
# Do NOT commit .env containing sensitive information to version control.

# Ollama LLM Configuration (Local Private Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text

# Chroma Vector Store Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
COLLECTION_NAME=knowledge_base

# Application Configuration
APP_NAME=Knowledge-Based Decision Agent
APP_ENV=development
LOG_LEVEL=INFO

# Optional External API Keys (Defaults run 100% locally and keylessly via Ollama & Chroma)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=