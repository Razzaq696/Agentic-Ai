# ==============================================================================
# Multi-Agent Problem Solving System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as necessary for your local setup.
# Do NOT commit .env containing sensitive information to version control.

# Ollama LLM Configuration (Local Private Inference)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0.0

# Optional External API Keys (Defaults run 100% locally and keylessly via Ollama)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=