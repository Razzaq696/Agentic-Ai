# =====================================================================
# AI SMART SHOPPING DECISION AGENT - CONFIGURATION
# =====================================================================

# LLM Provider: "openai", "google", "groq", "ollama", or "mock"
LLM_PROVIDER=openai

# Model Name
LLM_MODEL=gpt-4o-mini

# Temperature for requirement parsing (lower is more deterministic)
LLM_TEMPERATURE=0.0

# API Keys (Provide the key corresponding to your LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Ollama Base URL (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =====================================================================
# PHASE 2: EMBEDDINGS & CHROMA VECTOR STORE CONFIGURATION
# =====================================================================
# Embedding Provider: "openai", "google", "mock", or "auto"
EMBEDDING_PROVIDER=auto

# Embedding Model Identifier
EMBEDDING_MODEL=text-embedding-3-small

# Chroma Vector Storage
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=product_knowledge_base
PRODUCT_DATASET_PATH=./data/products.json
RAG_TOP_K=3
RAG_MAX_RETRIES=1

# =====================================================================
# PHASE 3: WEB SEARCH & PLAYWRIGHT BROWSER CONFIGURATION
# =====================================================================
# Search Provider: "mock", "duckduckgo", "tavily", or "serper"
SEARCH_PROVIDER=mock
SEARCH_MAX_RESULTS=3

# Optional Search API Keys (only required if provider is tavily or serper)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Playwright Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=10000
MAX_REACT_ITERATIONS=2

# =====================================================================
# PHASE 5: OBSERVABILITY & AUTOMATION (LANGSMITH, n8n, SENDGRID, PUSHOVER)
# =====================================================================
# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=shopping-decision-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# n8n Automation Webhook
N8N_ENABLED=false
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/shopping-recommendation
N8N_TIMEOUT_SEC=5.0

# SendGrid Email Delivery
SENDGRID_ENABLED=false
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=shopping-agent@yourdomain.com
SENDGRID_TO_EMAIL=buyer@example.com
SENDGRID_TIMEOUT_SEC=5.0

# Pushover Push Notifications
PUSHOVER_ENABLED=false
PUSHOVER_USER_KEY=your_pushover_user_key_here
PUSHOVER_API_TOKEN=your_pushover_app_token_here
PUSHOVER_TIMEOUT_SEC=5.0
